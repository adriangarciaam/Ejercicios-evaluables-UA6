{
  "name": "steamlike-backend-devcontainer",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "runServices": ["backend"],
  "workspaceFolder": "/workspace",
  "forwardPorts": [8000],
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.vscode-pylance",
        "redhat.java"
      ]
    }
  }
}
